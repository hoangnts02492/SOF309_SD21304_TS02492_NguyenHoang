{
  "name": "conbovuive-gear",
  "version": "2.0.0",
  "description": "Conbovuive Gear - Modern Gaming Gear & High-End PC Hardware Store",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "keywords": [
    "gaming-gear",
    "ecommerce",
    "tailwindcss",
    "nodejs",
    "express"
  ],
  "author": "Conbovuive Gear",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
